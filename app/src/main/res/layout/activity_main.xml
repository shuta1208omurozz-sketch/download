<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/panelBackdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent">
  <FrameLayout android:id="@+id/panelShell" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="12dp" android:background="@drawable/panel_background" android:elevation="8dp">
    <ScrollView android:id="@+id/panelCard" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="false">
      <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="24dp" android:paddingTop="8dp" android:paddingBottom="46dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
          <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="FloatSaver" android:textSize="18sp" android:textStyle="bold" android:textColor="#14213D"/>
          <TextView android:id="@+id/panelMoveHandle" android:layout_width="40dp" android:layout_height="44dp" android:text="⠿" android:textSize="23sp" android:gravity="center" android:textColor="#3967B7" android:contentDescription="ドラッグして小窓を動かす"/>
          <Button android:id="@+id/closeButton" android:layout_width="42dp" android:layout_height="42dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="×" android:textSize="19sp" android:contentDescription="小窓を閉じる"/>
        </LinearLayout>
        <EditText android:id="@+id/urlInput" android:layout_width="match_parent" android:layout_height="44dp" android:minHeight="0dp" android:singleLine="true" android:inputType="textUri" android:hint="動画ページのURL" android:textSize="14sp" android:textColor="#14213D"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
          <Button android:id="@+id/braveUrlButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp" android:text="ページ取得" android:textSize="13sp"/>
          <Button android:id="@+id/pasteButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp" android:text="URLを貼る" android:textSize="13sp"/>
        </LinearLayout>
        <Button android:id="@+id/analyzeButton" android:layout_width="match_parent" android:layout_height="46dp" android:text="動画を調べる" android:textSize="15sp" android:textColor="#FFFFFF" android:backgroundTint="#2563EB"/>
        <ProgressBar android:id="@+id/workingBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="gone"/>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="7dp" android:textSize="13sp" android:textColor="#43516A" android:text="ページを取得するか、URLを貼り付けてください。"/>
        <LinearLayout android:id="@+id/selectionSection" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
          <TextView android:id="@+id/titleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="動画情報" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" android:textColor="#14213D"/>
          <TextView android:id="@+id/durationText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="再生時間：不明" android:textSize="13sp" android:textColor="#64748B"/>
          <Button android:id="@+id/downloadButton" android:layout_width="match_parent" android:layout_height="46dp" android:enabled="false" android:text="この画質で保存" android:textSize="15sp" android:textColor="#FFFFFF" android:backgroundTint="#2563EB"/>
          <Button android:id="@+id/advancedToggleButton" android:layout_width="match_parent" android:layout_height="40dp" android:text="画質・形式を選ぶ ▾" android:textSize="13sp"/>
          <LinearLayout android:id="@+id/advancedOptions" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="画質" android:textSize="13sp"/>
            <Spinner android:id="@+id/qualitySpinner" android:layout_width="match_parent" android:layout_height="44dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="容量の上限" android:textSize="13sp"/>
            <Spinner android:id="@+id/limitSpinner" android:layout_width="match_parent" android:layout_height="44dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="保存形式" android:textSize="13sp"/>
            <Spinner android:id="@+id/containerSpinner" android:layout_width="match_parent" android:layout_height="44dp"/>
            <TextView android:id="@+id/sizeNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#64748B"/>
          </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/browserButton" android:layout_width="match_parent" android:layout_height="44dp" android:text="▶ 再生して動画を探す" android:textSize="14sp"/>
        <Button android:id="@+id/fallbackBrowserButton" android:layout_width="match_parent" android:layout_height="44dp" android:visibility="gone" android:text="▶ 再生画面で探す" android:textSize="14sp"/>
        <Button android:id="@+id/moreButton" android:layout_width="match_parent" android:layout_height="40dp" android:text="その他の設定 ▾" android:textSize="13sp"/>
        <LinearLayout android:id="@+id/moreSection" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
          <TextView android:id="@+id/urlCaptureStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#64748B"/>
          <Button android:id="@+id/historyButton" android:layout_width="match_parent" android:layout_height="42dp" android:text="保存履歴" android:textSize="13sp"/>
          <Button android:id="@+id/overlayButton" android:layout_width="match_parent" android:layout_height="42dp" android:text="フローティング設定" android:textSize="13sp"/>
          <Button android:id="@+id/resetPanelSizeButton" android:layout_width="match_parent" android:layout_height="42dp" android:text="小窓の大きさ・位置を戻す" android:textSize="13sp"/>
          <Button android:id="@+id/stopFloatingButton" android:layout_width="match_parent" android:layout_height="42dp" android:text="フローティングを終了" android:textSize="13sp"/>
          <TextView android:id="@+id/versionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="v0.22" android:textSize="11sp" android:gravity="center_horizontal" android:textColor="#64748B"/>
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/resizeRightHandle" android:layout_width="24dp" android:layout_height="68dp" android:layout_gravity="end|center_vertical" android:gravity="center" android:text="↔" android:textSize="20sp" android:background="#E1ECFF" android:textColor="#2456B8" android:contentDescription="右端をドラッグして横幅を変更"/>
    <TextView android:id="@+id/resizeBottomHandle" android:layout_width="80dp" android:layout_height="24dp" android:layout_gravity="bottom|center_horizontal" android:gravity="center" android:text="↕" android:textSize="20sp" android:background="#E1ECFF" android:textColor="#2456B8" android:contentDescription="下端をドラッグして高さを変更"/>
    <TextView android:id="@+id/resizeBottomLeftHandle" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="bottom|start" android:gravity="center" android:text="↙" android:textSize="23sp" android:background="#C3D9FF" android:textColor="#2456B8" android:contentDescription="左下角から大きさを変更"/>
    <TextView android:id="@+id/resizeCornerHandle" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="bottom|end" android:gravity="center" android:text="↘" android:textSize="23sp" android:background="#C3D9FF" android:textColor="#2456B8" android:contentDescription="右下角から大きさを変更"/>
  </FrameLayout>
</FrameLayout>
